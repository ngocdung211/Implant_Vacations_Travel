[Unit]
Description=Medical Clinic Flask App
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/Implant_Vacations_Travel
Environment="PORT=4999"
Environment="FLASK_DEBUG=false"
ExecStart=/home/ec2-user/Implant_Vacations_Travel/venv/bin/gunicorn --workers 2 --bind 127.0.0.1:4999 app:app
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
